    "# Run analysis for all 4 individual cases\n",
    "print(\"REFUSAL VS SCRATCH SAMPLING ANALYSIS\")\n",
    "print(\"Analyzing 4 combinations: [direct_request, command] x [batch6A, batch6B]\")\n",
    "print(\"Plus a 5th combined analysis of all cases together\")\n",
    "print(\"\\nThis analysis compares:\")\n",
    "print(\"- First responses (scratch sampling): The very first response in each conversation\")\n",
