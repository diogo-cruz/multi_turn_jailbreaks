   "source": [
    "# Summary table of all cases\n",
    "if all_case_results:\n",
    "    print(\"\\n\" + \"=\"*100)\n",
    "    print(\"SUMMARY TABLE OF ALL CASES\")\n",
    "    print(\"=\"*100)\n",
    "    \n",
    "    summary_data = []\n",
    "    for result in all_case_results:\n",
    "        first_numeric, first_refusals, first_total = prepare_histogram_data(result['first_responses'])\n",
    "        subsequent_numeric, subsequent_refusals, subsequent_total = prepare_histogram_data(result['subsequent_responses'])\n",
    "        \n",
    "        first_refusal_rate = first_refusals / first_total * 100 if first_total > 0 else 0\n",
    "        subsequent_refusal_rate = subsequent_refusals / subsequent_total * 100 if subsequent_total > 0 else 0\n",
    "        refusal_rate_diff = subsequent_refusal_rate - first_refusal_rate\n",
    "        \n",
    "        first_mean = np.mean(first_numeric) if first_numeric else None\n",
    "        subsequent_mean = np.mean(subsequent_numeric) if subsequent_numeric else None\n",
    "        \n",
    "        summary_data.append({\n",
    "            'Case': f\"{result['batch']} - {result['tactic']}\",\n",
    "            'Conversations': result['conversations'],\n",
    "            'First Total': first_total,\n",
    "            'Subsequent Total': subsequent_total,\n",
    "            'First Refusal Rate': f\"{first_refusal_rate:.1f}%\",\n",
    "            'Subsequent Refusal Rate': f\"{subsequent_refusal_rate:.1f}%\",\n",
    "            'Refusal Rate Diff': f\"{refusal_rate_diff:+.1f}pp\",\n",
    "            'First Mean': f\"{first_mean:.3f}\" if first_mean is not None else \"N/A\",\n",
    "            'Subsequent Mean': f\"{subsequent_mean:.3f}\" if subsequent_mean is not None else \"N/A\",\n",
    "            'P-value': f\"{result['p_value']:.6f}\" if result['p_value'] is not None else \"N/A\"\n",
    "        })\n",
    "    \n",
    "    summary_df = pd.DataFrame(summary_data)\n",
    "    print(\"\\n\", summary_df.to_string(index=False))\n",
    "    \n",
    "    # Final insights\n",
    "    print(\"\\n\" + \"=\"*60)\n",
    "    print(\"FINAL INSIGHTS\")\n",
    "    print(\"=\"*60)\n",
    "    \n",
    "    valid_p_values = [r['p_value'] for r in all_case_results if r['p_value'] is not None]\n",
    "    if valid_p_values:\n",
    "        significant_cases = [p for p in valid_p_values if p < 0.05]\n",
    "        print(f\"\\n1. Individual cases with significant differences: {len(significant_cases)}/{len(valid_p_values)}\")\n",
    "        \n",
    "        if len(significant_cases) > 0:\n",
    "            print(f\"   Cases with p < 0.05: {significant_cases}\")\n",
    "        else:\n",
    "            print(f\"   No individual cases showed statistically significant differences\")\n",
    "    \n",
    "    print(f\"\\n2. The combined analysis pooled {sum(r['conversations'] for r in all_case_results)} total conversations\")\n",
    "    print(f\"   from {len(all_case_results)} different experimental conditions.\")\n",
    "    \n",
    "    print(f\"\\n3. This provides the most definitive answer about sampling equivalence\")\n",
    "    print(f\"   by maximizing statistical power through the largest possible sample size.\")"
   ]
  }
